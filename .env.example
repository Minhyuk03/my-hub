# 이 파일을 .env.local 로 복사해 값을 넣는다:  cp .env.example .env.local && chmod 600 .env.local
# .env.local 은 git 에 올라가지 않는다. 값은 로그·화면·채팅에 출력하지 않는다.
# 쓰지 않는 서비스는 비워 두면 된다.

# Google Drive (OAuth "데스크톱 앱", drive.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion 내부 통합 (콘텐츠 읽기만)
NOTION_TOKEN=

# GitHub fine-grained PAT (Metadata·Contents·Issues·Pull requests 읽기만)
GITHUB_TOKEN=

# Figma 개인 액세스 토큰 (파일 내용·프로젝트 읽기만)
FIGMA_TOKEN=

# AI 채팅 외부 모델 (선택. 설정 → AI 채팅 → "외부 AI 사용" 을 켜야 쓰인다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI 코드 작업: 서버가 실행할 신뢰하는 Git 저장소 루트만 절대 경로 JSON 배열로 등록
# 비워 두면 ~/code/my-hub 한 곳만 사용. 변경 후 웹 서버 재시작.
# HUB_AI_PROJECTS=["/Users/mh/code/my-hub","/Users/mh/code/other-project"]
# LaunchAgent PATH에 CLI가 없다면 설치된 실행 파일의 절대 경로 지정
# HUB_CODEX_BIN=/opt/homebrew/bin/codex
# HUB_CLAUDE_BIN=/Users/mh/.local/bin/claude
