# 이 파일을 .env.local 로 복사해 값을 넣는다:  cp .env.example .env.local && chmod 600 .env.local
# .env.local 은 git 에 올라가지 않는다. 값은 로그·화면·채팅에 출력하지 않는다.
# 쓰지 않는 서비스는 비워 두면 된다.

# Google Drive (OAuth "데스크톱 앱", drive.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion 내부 통합 (콘텐츠 읽기만)
NOTION_TOKEN=

# GitHub fine-grained PAT (Metadata·Contents·Issues·Pull requests 읽기만)
GITHUB_TOKEN=

# Figma 개인 액세스 토큰 (파일 내용·프로젝트 읽기만)
FIGMA_TOKEN=

# AI 채팅 외부 모델 (선택. 설정 → AI 채팅 → "외부 AI 사용" 을 켜야 쓰인다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
