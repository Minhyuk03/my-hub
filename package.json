{
  "name": "my-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "bench:korean": "tsx scripts/phase0/korean-search-bench.ts --scale 100000",
    "migrate": "tsx scripts/migrate.ts",
    "worker": "tsx worker/index.ts",
    "hub": "npm run migrate && concurrently -k -n web,worker -c blue,green \"npm:dev\" \"npm:worker\"",
    "restore": "tsx scripts/restore.ts",
    "backup": "tsx scripts/backup-now.ts",
    "bench:hub": "tsx scripts/bench/hub-bench.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
